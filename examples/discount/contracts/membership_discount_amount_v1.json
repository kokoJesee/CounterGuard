{
  "contract_id": "membership-discount-amount-v1",
  "contract_family": "membership_discount",
  "contract_version": "v1",
  "interface_kind": "discount_amount",
  "target_symbol": "calculate_discount",
  "symbol_signature": "decimal_bool_to_decimal",
  "argument_types": {"amount": "decimal", "is_member": "boolean"},
  "return_type": "decimal",
  "rounding": "ROUND_HALF_UP",
  "cases": [
    {
      "case_id": "member-discount",
      "args": {"amount": "100.00", "is_member": true},
      "expected": "20.00"
    },
    {
      "case_id": "non-member-discount",
      "args": {"amount": "100.00", "is_member": false},
      "expected": "0.00"
    },
    {
      "case_id": "member-rounding",
      "args": {"amount": "12.55", "is_member": true},
      "expected": "2.51"
    },
    {
      "case_id": "negative-amount",
      "args": {"amount": "-0.01", "is_member": true},
      "raises": "ValueError"
    }
  ]
}
