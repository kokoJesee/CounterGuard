{
  "contract_id": "input-limit-batch-v1",
  "contract_family": "input_limit",
  "contract_version": "v1",
  "interface_kind": "worker_batch",
  "target_symbol": "parse_limit",
  "symbol_signature": "optional_string_to_integer",
  "argument_types": {"raw": "optional_string"},
  "return_type": "integer",
  "lexical_policy": "ascii_decimal_digits_with_leading_zeroes",
  "cases": [
    {"args": {"raw": null}, "expected": 250},
    {"args": {"raw": "1"}, "expected": 1},
    {"args": {"raw": "01"}, "expected": 1},
    {"args": {"raw": "500"}, "expected": 500},
    {"args": {"raw": "1000"}, "expected": 1000},
    {"args": {"raw": "0"}, "raises": "ValueError"},
    {"args": {"raw": "1001"}, "raises": "ValueError"},
    {"args": {"raw": "ten"}, "raises": "ValueError"},
    {"args": {"raw": "+1"}, "raises": "ValueError"},
    {"args": {"raw": " 1 "}, "raises": "ValueError"},
    {"args": {"raw": "1_0"}, "raises": "ValueError"},
    {"args": {"raw": "１２"}, "raises": "ValueError"},
    {"args": {"raw": "-1"}, "raises": "ValueError"}
  ]
}
