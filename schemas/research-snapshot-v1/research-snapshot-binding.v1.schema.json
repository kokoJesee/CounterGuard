{
  "$defs": {
    "DraftCase": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "pattern": "^case_[a-f0-9]{24}$",
          "title": "Case Id",
          "type": "string"
        },
        "source_line": {
          "minimum": 1,
          "title": "Source Line",
          "type": "integer"
        },
        "assertion_index": {
          "minimum": 1,
          "title": "Assertion Index",
          "type": "integer"
        },
        "parameter_index": {
          "minimum": 1,
          "title": "Parameter Index",
          "type": "integer"
        },
        "assertion_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Assertion Digest",
          "type": "string"
        },
        "positional_args": {
          "items": {
            "$ref": "#/$defs/DraftLiteral"
          },
          "title": "Positional Args",
          "type": "array"
        },
        "keyword_args": {
          "items": {
            "$ref": "#/$defs/DraftKeyword"
          },
          "title": "Keyword Args",
          "type": "array"
        },
        "oracle": {
          "enum": [
            "eq",
            "ne",
            "is",
            "is_not",
            "truthy",
            "falsey",
            "raises"
          ],
          "title": "Oracle",
          "type": "string"
        },
        "expected": {
          "anyOf": [
            {
              "$ref": "#/$defs/DraftLiteral"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "exception": {
          "anyOf": [
            {
              "enum": [
                "ValueError",
                "TypeError",
                "OverflowError"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exception"
        }
      },
      "required": [
        "case_id",
        "source_line",
        "assertion_index",
        "parameter_index",
        "assertion_digest",
        "positional_args",
        "keyword_args",
        "oracle"
      ],
      "title": "DraftCase",
      "type": "object"
    },
    "DraftKeyword": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 128,
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "literal": {
          "$ref": "#/$defs/DraftLiteral"
        }
      },
      "required": [
        "name",
        "literal"
      ],
      "title": "DraftKeyword",
      "type": "object"
    },
    "DraftLiteral": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "none",
            "boolean",
            "integer",
            "float",
            "string",
            "bytes",
            "list",
            "tuple",
            "dict"
          ],
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        },
        "items": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DraftLiteral"
          },
          "title": "Items",
          "type": "array"
        },
        "entries": {
          "default": [],
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "$ref": "#/$defs/DraftLiteral"
              },
              {
                "$ref": "#/$defs/DraftLiteral"
              }
            ],
            "type": "array"
          },
          "title": "Entries",
          "type": "array"
        }
      },
      "required": [
        "kind"
      ],
      "title": "DraftLiteral",
      "type": "object"
    },
    "DraftMatchCase": {
      "additionalProperties": false,
      "description": "New case shape; old DraftCase continues to reject this extra field.",
      "properties": {
        "case_id": {
          "pattern": "^case_[a-f0-9]{24}$",
          "title": "Case Id",
          "type": "string"
        },
        "source_line": {
          "minimum": 1,
          "title": "Source Line",
          "type": "integer"
        },
        "assertion_index": {
          "minimum": 1,
          "title": "Assertion Index",
          "type": "integer"
        },
        "parameter_index": {
          "minimum": 1,
          "title": "Parameter Index",
          "type": "integer"
        },
        "assertion_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Assertion Digest",
          "type": "string"
        },
        "positional_args": {
          "items": {
            "$ref": "#/$defs/DraftLiteral"
          },
          "title": "Positional Args",
          "type": "array"
        },
        "keyword_args": {
          "items": {
            "$ref": "#/$defs/DraftKeyword"
          },
          "title": "Keyword Args",
          "type": "array"
        },
        "oracle": {
          "enum": [
            "eq",
            "ne",
            "is",
            "is_not",
            "truthy",
            "falsey",
            "raises"
          ],
          "title": "Oracle",
          "type": "string"
        },
        "expected": {
          "anyOf": [
            {
              "$ref": "#/$defs/DraftLiteral"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "exception": {
          "anyOf": [
            {
              "enum": [
                "ValueError",
                "TypeError",
                "OverflowError"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exception"
        },
        "exception_match": {
          "maxLength": 4096,
          "title": "Exception Match",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "source_line",
        "assertion_index",
        "parameter_index",
        "assertion_digest",
        "positional_args",
        "keyword_args",
        "oracle",
        "exception_match"
      ],
      "title": "DraftMatchCase",
      "type": "object"
    },
    "FilePin": {
      "additionalProperties": false,
      "properties": {
        "revision": {
          "enum": [
            "base",
            "head"
          ],
          "title": "Revision",
          "type": "string"
        },
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "object_id": {
          "title": "Object Id",
          "type": "string"
        },
        "content_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Digest",
          "type": "string"
        }
      },
      "required": [
        "revision",
        "path",
        "object_id",
        "content_digest"
      ],
      "title": "FilePin",
      "type": "object"
    },
    "JsonValue": {},
    "SnapshotBudget": {
      "additionalProperties": false,
      "properties": {
        "blob_bytes": {
          "default": 8388608,
          "maximum": 8388608,
          "minimum": 1,
          "title": "Blob Bytes",
          "type": "integer"
        },
        "tree_bytes": {
          "default": 134217728,
          "maximum": 134217728,
          "minimum": 1,
          "title": "Tree Bytes",
          "type": "integer"
        },
        "file_count": {
          "default": 2048,
          "maximum": 2048,
          "minimum": 1,
          "title": "File Count",
          "type": "integer"
        }
      },
      "title": "SnapshotBudget",
      "type": "object"
    },
    "SnapshotContract": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "research-snapshot-contract.v1",
          "default": "research-snapshot-contract.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "profile": {
          "const": "source-only-python-snapshot.v1",
          "default": "source-only-python-snapshot.v1",
          "title": "Profile",
          "type": "string"
        },
        "contract_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$",
          "title": "Contract Id",
          "type": "string"
        },
        "buggy_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Buggy Commit",
          "type": "string"
        },
        "fixed_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Fixed Commit",
          "type": "string"
        },
        "target_module": {
          "maxLength": 256,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$",
          "title": "Target Module",
          "type": "string"
        },
        "target_symbol": {
          "maxLength": 128,
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$",
          "title": "Target Symbol",
          "type": "string"
        },
        "source_ref": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Source Ref",
          "type": "string"
        },
        "import_root": {
          "enum": [
            ".",
            "src"
          ],
          "title": "Import Root",
          "type": "string"
        },
        "test_origin": {
          "$ref": "#/$defs/SnapshotOrigin"
        },
        "cases": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/DraftMatchCase"
              },
              {
                "$ref": "#/$defs/DraftCase"
              }
            ]
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Cases",
          "type": "array"
        },
        "authority": {
          "const": "repository_declaration_not_execution_authorization",
          "default": "repository_declaration_not_execution_authorization",
          "title": "Authority",
          "type": "string"
        }
      },
      "required": [
        "contract_id",
        "buggy_commit",
        "fixed_commit",
        "target_module",
        "target_symbol",
        "source_ref",
        "import_root",
        "test_origin",
        "cases"
      ],
      "title": "SnapshotContract",
      "type": "object"
    },
    "SnapshotManifest": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "research-snapshot-manifest.v1",
          "default": "research-snapshot-manifest.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "commit": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Commit",
          "type": "string"
        },
        "budget": {
          "$ref": "#/$defs/SnapshotBudget"
        },
        "total_bytes": {
          "maximum": 134217728,
          "minimum": 0,
          "title": "Total Bytes",
          "type": "integer"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/FilePin"
          },
          "title": "Files",
          "type": "array"
        },
        "sizes": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Sizes",
          "type": "object"
        },
        "artifact_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Artifact Digest",
          "type": "string"
        }
      },
      "required": [
        "commit",
        "budget",
        "total_bytes",
        "files",
        "sizes",
        "artifact_digest"
      ],
      "title": "SnapshotManifest",
      "type": "object"
    },
    "SnapshotOrigin": {
      "additionalProperties": false,
      "properties": {
        "test_ref": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Test Ref",
          "type": "string"
        },
        "test_function": {
          "maxLength": 128,
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$",
          "title": "Test Function",
          "type": "string"
        },
        "test_object_id": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Test Object Id",
          "type": "string"
        },
        "test_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Test Digest",
          "type": "string"
        },
        "extractor_version": {
          "const": "snapshot-test-projection.v1",
          "default": "snapshot-test-projection.v1",
          "title": "Extractor Version",
          "type": "string"
        },
        "projection_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Projection Digest",
          "type": "string"
        }
      },
      "required": [
        "test_ref",
        "test_function",
        "test_object_id",
        "test_digest",
        "projection_digest"
      ],
      "title": "SnapshotOrigin",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "research-snapshot-binding.v1",
      "default": "research-snapshot-binding.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "profile": {
      "const": "source-only-python-snapshot.v1",
      "default": "source-only-python-snapshot.v1",
      "title": "Profile",
      "type": "string"
    },
    "status": {
      "const": "independent_review_required",
      "default": "independent_review_required",
      "title": "Status",
      "type": "string"
    },
    "head_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Head Commit",
      "type": "string"
    },
    "contract_ref": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Contract Ref",
      "type": "string"
    },
    "contract_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Contract Digest",
      "type": "string"
    },
    "contract": {
      "$ref": "#/$defs/SnapshotContract"
    },
    "trees": {
      "additionalProperties": {
        "$ref": "#/$defs/SnapshotManifest"
      },
      "propertyNames": {
        "enum": [
          "buggy",
          "fixed",
          "head"
        ]
      },
      "title": "Trees",
      "type": "object"
    },
    "package_refs": {
      "additionalProperties": {
        "items": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "type": "array"
      },
      "propertyNames": {
        "enum": [
          "buggy",
          "fixed",
          "head"
        ]
      },
      "title": "Package Refs",
      "type": "object"
    },
    "tool_additions": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "title": "Tool Additions",
      "type": "array"
    },
    "upstream_refs": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "title": "Upstream Refs",
      "type": "array"
    },
    "budget": {
      "$ref": "#/$defs/SnapshotBudget"
    },
    "execution_allowed": {
      "const": false,
      "default": false,
      "title": "Execution Allowed",
      "type": "boolean"
    },
    "semantic_review": {
      "const": "not_performed",
      "default": "not_performed",
      "title": "Semantic Review",
      "type": "string"
    },
    "implementation_digests": {
      "additionalProperties": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Implementation Digests",
      "type": "object"
    },
    "artifact_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Artifact Digest",
      "type": "string"
    }
  },
  "required": [
    "head_commit",
    "contract_ref",
    "contract_digest",
    "contract",
    "trees",
    "package_refs",
    "tool_additions",
    "upstream_refs",
    "budget",
    "implementation_digests",
    "artifact_digest"
  ],
  "title": "SnapshotBinding",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
