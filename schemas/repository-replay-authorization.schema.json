{
  "$defs": {
    "ExecutionInputPin": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "object_id": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Object Id",
          "type": "string"
        },
        "content_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Digest",
          "type": "string"
        }
      },
      "required": [
        "path",
        "object_id",
        "content_digest"
      ],
      "title": "ExecutionInputPin",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "docker-execution-authorization.v3",
      "default": "docker-execution-authorization.v3",
      "title": "Schema Version",
      "type": "string"
    },
    "backend": {
      "const": "docker",
      "default": "docker",
      "title": "Backend",
      "type": "string"
    },
    "import_root": {
      "const": "src",
      "default": "src",
      "title": "Import Root",
      "type": "string"
    },
    "image_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Image Digest",
      "type": "string"
    },
    "runner_review_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Runner Review Digest",
      "type": "string"
    },
    "policy_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Policy Digest",
      "type": "string"
    },
    "manifest_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Manifest Digest",
      "type": "string"
    },
    "inspection_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Inspection Digest",
      "type": "string"
    },
    "guard_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Guard Digest",
      "type": "string"
    },
    "evidence_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Evidence Digest",
      "type": "string"
    },
    "scope_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Scope Digest",
      "type": "string"
    },
    "registry_entry_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Registry Entry Digest",
      "type": "string"
    },
    "registry_event_tip_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Registry Event Tip Digest",
      "type": "string"
    },
    "head_commit": {
      "title": "Head Commit",
      "type": "string"
    },
    "implementation_digests": {
      "additionalProperties": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Implementation Digests",
      "type": "object"
    },
    "request_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Request Digest",
      "type": "string"
    },
    "input_pins": {
      "items": {
        "$ref": "#/$defs/ExecutionInputPin"
      },
      "title": "Input Pins",
      "type": "array"
    },
    "test_ref": {
      "minLength": 1,
      "title": "Test Ref",
      "type": "string"
    },
    "test_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Test Digest",
      "type": "string"
    },
    "artifact_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Artifact Digest",
      "type": "string"
    }
  },
  "required": [
    "image_digest",
    "runner_review_digest",
    "policy_digest",
    "manifest_digest",
    "inspection_digest",
    "guard_digest",
    "evidence_digest",
    "scope_digest",
    "registry_entry_digest",
    "registry_event_tip_digest",
    "head_commit",
    "implementation_digests",
    "request_digest",
    "input_pins",
    "test_ref",
    "test_digest",
    "artifact_digest"
  ],
  "title": "ReviewedReplayAuthorization",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
