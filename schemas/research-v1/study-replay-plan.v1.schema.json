{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "study-replay-plan.v1",
      "default": "study-replay-plan.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "purpose": {
      "const": "tool_owned_research_fixture_only",
      "default": "tool_owned_research_fixture_only",
      "title": "Purpose",
      "type": "string"
    },
    "source_ref": {
      "minLength": 1,
      "title": "Source Ref",
      "type": "string"
    },
    "target_ref": {
      "minLength": 1,
      "title": "Target Ref",
      "type": "string"
    },
    "map_ref": {
      "minLength": 1,
      "title": "Map Ref",
      "type": "string"
    },
    "review_ref": {
      "minLength": 1,
      "title": "Review Ref",
      "type": "string"
    },
    "witness_ref": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Witness Ref"
    },
    "method": {
      "enum": [
        "b1_always",
        "b2_interface",
        "learned_initial",
        "learned_refined"
      ],
      "title": "Method",
      "type": "string"
    },
    "lane": {
      "default": "guard",
      "enum": [
        "guard",
        "witness"
      ],
      "title": "Lane",
      "type": "string"
    },
    "timeout_seconds": {
      "default": 10.0,
      "exclusiveMinimum": 0,
      "maximum": 30,
      "title": "Timeout Seconds",
      "type": "number"
    },
    "artifact_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Artifact Digest",
      "type": "string"
    }
  },
  "required": [
    "source_ref",
    "target_ref",
    "map_ref",
    "review_ref",
    "method",
    "artifact_digest"
  ],
  "title": "StudyReplayPlan",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
