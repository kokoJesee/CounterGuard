{
  "$defs": {
    "DatasetFile": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "split": {
          "enum": [
            "train",
            "holdout"
          ],
          "title": "Split",
          "type": "string"
        },
        "guard_id": {
          "minLength": 1,
          "title": "Guard Id",
          "type": "string"
        },
        "content_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Digest",
          "type": "string"
        }
      },
      "required": [
        "path",
        "split",
        "guard_id",
        "content_digest"
      ],
      "title": "DatasetFile",
      "type": "object"
    },
    "TrainingPhases": {
      "additionalProperties": false,
      "properties": {
        "initial": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Initial",
          "type": "array"
        },
        "refinement_additions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Refinement Additions",
          "type": "array"
        },
        "holdout": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Holdout",
          "type": "array"
        }
      },
      "required": [
        "initial",
        "refinement_additions",
        "holdout"
      ],
      "title": "TrainingPhases",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "split-manifest.v1",
      "default": "split-manifest.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "split_id": {
      "const": "scope_v1",
      "default": "scope_v1",
      "title": "Split Id",
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/DatasetFile"
      },
      "title": "Files",
      "type": "array"
    },
    "phases": {
      "additionalProperties": {
        "$ref": "#/$defs/TrainingPhases"
      },
      "title": "Phases",
      "type": "object"
    },
    "source_text_digests": {
      "additionalProperties": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "propertyNames": {
        "minLength": 1
      },
      "title": "Source Text Digests",
      "type": "object"
    },
    "artifact_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Artifact Digest",
      "type": "string"
    }
  },
  "required": [
    "files",
    "phases",
    "source_text_digests",
    "artifact_digest"
  ],
  "title": "SplitManifest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
