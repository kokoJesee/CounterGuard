{
  "$defs": {
    "RunnerReview": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "runner-review.v1",
          "default": "runner-review.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "runner_id": {
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "title": "Runner Id",
          "type": "string"
        },
        "profile": {
          "enum": [
            "root-pytest8.v1",
            "validators-src-pytest9.v1"
          ],
          "title": "Profile",
          "type": "string"
        },
        "image_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Image Digest",
          "type": "string"
        },
        "pytest_version": {
          "enum": [
            "8.4.2",
            "9.0.3"
          ],
          "title": "Pytest Version",
          "type": "string"
        },
        "base_registry_digests": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Base Registry Digests",
          "type": "array"
        },
        "build_receipt_ref": {
          "minLength": 1,
          "title": "Build Receipt Ref",
          "type": "string"
        },
        "build_receipt_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Build Receipt Digest",
          "type": "string"
        },
        "lock_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Lock Digest",
          "type": "string"
        },
        "container_source_digests": {
          "additionalProperties": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Container Source Digests",
          "type": "object"
        },
        "attack_receipt_ref": {
          "minLength": 1,
          "title": "Attack Receipt Ref",
          "type": "string"
        },
        "attack_receipt_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Attack Receipt Digest",
          "type": "string"
        },
        "attack_log_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Attack Log Digest",
          "type": "string"
        },
        "attacks_passed": {
          "const": 4,
          "default": 4,
          "title": "Attacks Passed",
          "type": "integer"
        },
        "reviewed_at": {
          "format": "date-time",
          "title": "Reviewed At",
          "type": "string"
        },
        "artifact_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Artifact Digest",
          "type": "string"
        }
      },
      "required": [
        "runner_id",
        "profile",
        "image_digest",
        "pytest_version",
        "base_registry_digests",
        "build_receipt_ref",
        "build_receipt_digest",
        "lock_digest",
        "container_source_digests",
        "attack_receipt_ref",
        "attack_receipt_digest",
        "attack_log_digest",
        "reviewed_at",
        "artifact_digest"
      ],
      "title": "RunnerReview",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "standalone-capture.v1",
      "default": "standalone-capture.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "evidence_id": {
      "pattern": "^evd_[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
      "title": "Evidence Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "output_ref": {
      "minLength": 1,
      "title": "Output Ref",
      "type": "string"
    },
    "binding_ref": {
      "minLength": 1,
      "title": "Binding Ref",
      "type": "string"
    },
    "binding_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Binding Digest",
      "type": "string"
    },
    "runner": {
      "$ref": "#/$defs/RunnerReview"
    },
    "review_reason": {
      "maxLength": 1024,
      "minLength": 1,
      "title": "Review Reason",
      "type": "string"
    },
    "review_authority": {
      "const": "trusted_local_operator_not_authenticated_identity",
      "default": "trusted_local_operator_not_authenticated_identity",
      "title": "Review Authority",
      "type": "string"
    },
    "generator_version": {
      "const": "standalone-test.v1",
      "default": "standalone-test.v1",
      "title": "Generator Version",
      "type": "string"
    },
    "timeout_seconds": {
      "exclusiveMinimum": 0,
      "maximum": 30,
      "title": "Timeout Seconds",
      "type": "number"
    },
    "implementation_digests": {
      "additionalProperties": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Implementation Digests",
      "type": "object"
    },
    "policy_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Policy Digest",
      "type": "string"
    },
    "artifact_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Artifact Digest",
      "type": "string"
    }
  },
  "required": [
    "evidence_id",
    "created_at",
    "output_ref",
    "binding_ref",
    "binding_digest",
    "runner",
    "review_reason",
    "timeout_seconds",
    "implementation_digests",
    "policy_digest",
    "artifact_digest"
  ],
  "title": "StandaloneCapture",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
