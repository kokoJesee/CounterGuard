{
  "$defs": {
    "RunnerReview": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "runner-review.v1",
          "default": "runner-review.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "runner_id": {
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "title": "Runner Id",
          "type": "string"
        },
        "profile": {
          "enum": [
            "root-pytest8.v1",
            "validators-src-pytest9.v1"
          ],
          "title": "Profile",
          "type": "string"
        },
        "image_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Image Digest",
          "type": "string"
        },
        "pytest_version": {
          "enum": [
            "8.4.2",
            "9.0.3"
          ],
          "title": "Pytest Version",
          "type": "string"
        },
        "base_registry_digests": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Base Registry Digests",
          "type": "array"
        },
        "build_receipt_ref": {
          "minLength": 1,
          "title": "Build Receipt Ref",
          "type": "string"
        },
        "build_receipt_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Build Receipt Digest",
          "type": "string"
        },
        "lock_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Lock Digest",
          "type": "string"
        },
        "container_source_digests": {
          "additionalProperties": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Container Source Digests",
          "type": "object"
        },
        "attack_receipt_ref": {
          "minLength": 1,
          "title": "Attack Receipt Ref",
          "type": "string"
        },
        "attack_receipt_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Attack Receipt Digest",
          "type": "string"
        },
        "attack_log_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Attack Log Digest",
          "type": "string"
        },
        "attacks_passed": {
          "const": 4,
          "default": 4,
          "title": "Attacks Passed",
          "type": "integer"
        },
        "reviewed_at": {
          "format": "date-time",
          "title": "Reviewed At",
          "type": "string"
        },
        "artifact_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Artifact Digest",
          "type": "string"
        }
      },
      "required": [
        "runner_id",
        "profile",
        "image_digest",
        "pytest_version",
        "base_registry_digests",
        "build_receipt_ref",
        "build_receipt_digest",
        "lock_digest",
        "container_source_digests",
        "attack_receipt_ref",
        "attack_receipt_digest",
        "attack_log_digest",
        "reviewed_at",
        "artifact_digest"
      ],
      "title": "RunnerReview",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "runner-catalog.v1",
      "default": "runner-catalog.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "reviews": {
      "items": {
        "$ref": "#/$defs/RunnerReview"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Reviews",
      "type": "array"
    },
    "artifact_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Artifact Digest",
      "type": "string"
    }
  },
  "required": [
    "reviews",
    "artifact_digest"
  ],
  "title": "RunnerCatalog",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
